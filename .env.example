# Cursor (review engine)
# API key with access to the composer-2.5 model.
CURSOR_API_KEY=

# GitLab (read for context/discovery; write under bot account in phase 2+)
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
# Shared secret checked against the X-Gitlab-Token webhook header (phase 2).
# Leave empty to disable verification (NOT recommended in production).
GITLAB_WEBHOOK_SECRET=
# Optional GitLab bot username for ignoring Mira's own notes. If empty, Mira
# calls GET /user with GITLAB_TOKEN at startup.
GITLAB_BOT_USERNAME=

# Publisher mode: `log` (dry-run, default) or `gitlab` (real, idempotent MR
# review under the bot account). Keep `log` until the bot has write access to
# pilot repos (🔑P2).
MIRA_PUBLISHER=log

# Kaiten (read task description + acceptance criteria)
# NOTE: during PoC/MVP this may be a PERSONAL user token — use READ-ONLY only.
# Никаких записей (comments / external links / статусы / чек-листы). Для записи
# в Kaiten завести отдельный сервис-аккаунт/бот-токен.
KAITEN_BASE_URL=https://your-space.kaiten.ru
KAITEN_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Опциональные ускорители (см. docs/02-guides/performance-scaling.md).
# Дефолты сохраняют поведение MVP (один процесс, без внешних сервисов).
# ──────────────────────────────────────────────────────────────────────────────

# Очередь задач: `inproc` (по умолчанию, один процесс) или `redis` (общая очередь
# для нескольких worker-процессов/подов). Для redis требуется REDIS_URL и пакет
# `ioredis` (optionalDependency).
MIRA_QUEUE=inproc
REDIS_URL=redis://localhost:6379
# Префикс ключей Redis (по умолчанию `mira`): mira:queue (список), mira:pending (set).
MIRA_QUEUE_PREFIX=mira

# State store: `sqlite` (по умолчанию, один узел) или `postgres` (конкурентная
# запись из нескольких worker'ов). Для postgres требуется DATABASE_URL и пакет
# `pg` (optionalDependency). Включать вместе с MIRA_QUEUE=redis при масштабе >1.
MIRA_STORE=sqlite
DATABASE_URL=postgres://mira:mira@localhost:5432/mira

# Стратегия чекаута: `fresh` (по умолчанию, свежий blobless-clone на каждый job)
# или `mirror` (персистентный bare-кэш объектов + clone --reference, переиспользует
# объекты между ревью одного репо). Кэш-каталог по умолчанию — <WORKSPACE_ROOT|tmp>/mira-mirror-cache.
MIRA_CHECKOUT=fresh
MIRA_CHECKOUT_CACHE_DIR=

# TTL-кэш чтения карточек Kaiten в памяти. `on` включает, `off` (по умолчанию).
MIRA_READ_CACHE=off
MIRA_READ_CACHE_TTL_MS=300000
